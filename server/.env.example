# Variáveis do servidor do MCP.
# Os valores reais ficam só no painel da Vercel. Nunca comite um arquivo .env.

# Endereço do projeto Supabase (Project Settings → API).
SUPABASE_URL=

# Chave pública do projeto Supabase ("publishable", começa com sb_publishable_).
# Nunca use a chave secreta nem a service_role aqui.
SUPABASE_PUBLISHABLE_KEY=
